---
interface Props {
  logId: string;
  category: string;
  metric: string;
  title: string;
  description: string;
  tags: string[];
  image: string;
}

const { logId, category, metric, title, description, tags, image } = Astro.props;
---

<div class="glass-card-hover group overflow-hidden flex flex-col h-full">
  <!-- Card Image Header -->
  <div class="relative h-56 sm:h-64 w-full overflow-hidden bg-dark-950">
    <img
      src={image}
      alt={`${title} - Case Study by Shishir Khanal`}
      width="600"
      height="360"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-900 via-dark-900/40 to-transparent"></div>
    
    <!-- Top Log Badge -->
    <div class="absolute top-4 left-4 flex items-center gap-2">
      <span class="px-2.5 py-1 rounded-md bg-dark-950/90 border border-white/20 font-mono text-[11px] text-cyan font-bold tracking-wider">
        {logId}
      </span>
      <span class="px-2.5 py-1 rounded-md bg-dark-950/90 border border-white/20 font-mono text-[11px] text-slate-300 uppercase">
        {category}
      </span>
    </div>

    <!-- Metric pill overlay -->
    <div class="absolute bottom-4 left-4">
      <span class="px-3 py-1.5 rounded-lg bg-emerald-500/20 border border-emerald-500/50 backdrop-blur-md text-emerald-300 font-mono text-xs font-bold tracking-wider shadow-lg">
        ⚡ {metric}
      </span>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex flex-col flex-1 justify-between">
    <div>
      <h3 class="font-display font-bold text-xl sm:text-2xl text-white group-hover:text-cyan transition-colors">
        {title}
      </h3>
      <p class="mt-3 text-sm text-slate-300 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Tags footer -->
    <div class="mt-6 pt-5 border-t border-white/10 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="px-2.5 py-1 rounded-md bg-dark-800/80 border border-white/10 text-[11px] font-mono text-slate-300">
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>
