---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
}

const {
  title = "Shishir Khanal | Digital Marketing Strategist & Growth Consultant in Nepal",
  description = "Shishir Khanal is a Digital Marketing Strategist and Growth Consultant in Kathmandu, Nepal helping brands grow through strategy, performance marketing, SEO, and storytelling.",
  image = "/images/shishir-profile.jpg",
  currentPath = Astro.url.pathname,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://khanalshishir.com.np');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%2306080d'/><text x='50' y='65' font-size='50' font-family='monospace' font-weight='bold' fill='%2300f0ff' text-anchor='middle'>SK</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Shishir Khanal, digital marketing Nepal, marketing strategist Kathmandu, growth consultant Nepal, SEO Nepal, performance marketing Nepal, brand building Nepal, content strategy, khanalshishir.com.np" />
    <meta name="author" content="Shishir Khanal" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Shishir Khanal // Digital Marketing Strategist" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:alt" content="Shishir Khanal - Digital Marketing Strategist" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL)} />
    <meta name="twitter:image:alt" content="Shishir Khanal" />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#06080d" />
    <meta name="msapplication-navbutton-color" content="#06080d" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class="min-h-screen flex flex-col relative tech-grid text-slate-100">
    <div id="top"></div>

    <!-- Ambient High-Contrast Glow Elements -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-cyan/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed top-1/3 -right-48 w-[500px] h-[500px] bg-accent-indigo/10 rounded-full blur-[160px] pointer-events-none -z-10"></div>
    <div class="fixed bottom-10 -left-48 w-[500px] h-[500px] bg-emerald-500/10 rounded-full blur-[160px] pointer-events-none -z-10"></div>

    <Navbar currentPath={currentPath} />

    <main class="flex-1 w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>
