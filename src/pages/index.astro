---
import Layout from '../layouts/Layout.astro';
import StatCounter from '../components/StatCounter.astro';
import IndustryExplorer from '../components/IndustryExplorer.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ContactForm from '../components/ContactForm.astro';

const caseStudies = [
  {
    logId: 'LOG #01',
    category: 'EDTECH',
    metric: '3.8X STUDENT ENROLLMENTS',
    title: 'Higher-Ed Enrollment Propulsion',
    description: 'Transformed an institution\'s recruitment funnel through high-resonance student story campaigns, program-specific landing pages, and automated lead nurturing sequences.',
    tags: ['Storytelling', 'Organic SEO', 'WhatsApp Nurturing'],
    image: '/images/work-1.jpg'
  },
  {
    logId: 'LOG #02',
    category: 'HEALTHCARE',
    metric: '4.2X APPOINTMENT INTAKE',
    title: 'Healthcare Network Authority & Growth',
    description: 'Developed a trust-first digital patient journey with verified specialist content, localized Google search dominance, and frictionless consultation booking pathways.',
    tags: ['Brand Authority', 'Local Search & Maps', 'Compliance-Ready'],
    image: '/images/work-2.jpg'
  },
  {
    logId: 'LOG #03',
    category: 'E-COMMERCE',
    metric: '5.2X PEAK ROAS',
    title: 'D2C Retail Omnichannel Scale-Up',
    description: 'Designed a rapid creative testing engine on TikTok and Meta coupled with email recovery automations, generating 5.2x return on ad spend during key seasonal sales windows.',
    tags: ['Omnichannel Paid Media', 'Creative Testing', 'Retention Drip'],
    image: '/images/work-3.jpg'
  }
];

const engines = [
  {
    num: 'ENGINE 01',
    icon: '🎯',
    title: 'Digital Marketing Strategy',
    description: 'Developing comprehensive marketing roadmaps that align business goals with measurable outcomes.',
    tags: ['STRATEGY FIRST', 'MEASURABLE ROADMAPS']
  },
  {
    num: 'ENGINE 02',
    icon: '📈',
    title: 'Performance Marketing',
    description: 'Planning and managing paid advertising campaigns across Meta, Google, TikTok, LinkedIn, and other digital platforms.',
    tags: ['HIGH ROAS', 'PAID AD ENGINE']
  },
  {
    num: 'ENGINE 03',
    icon: '🛡️',
    title: 'Brand Building',
    description: 'Creating strong brand positioning, messaging frameworks, and communication strategies that stand out in competitive markets.',
    tags: ['CATEGORY AUTHORITY', 'MESSAGING FRAMES']
  },
  {
    num: 'ENGINE 04',
    icon: '✍️',
    title: 'Content & Storytelling',
    description: 'Transforming complex ideas into compelling content that educates, inspires, and converts audiences.',
    tags: ['NARRATIVE RESONANCE', 'AUDIENCE CONVERSION']
  },
  {
    num: 'ENGINE 05',
    icon: '🚀',
    title: 'Team Leadership',
    description: 'Building, mentoring, and managing high-performing marketing teams that drive sustainable growth.',
    tags: ['AGILE SPRINT UNITS', 'TALENT MENTORSHIP']
  },
  {
    num: 'ENGINE 06',
    icon: '🔮',
    title: 'Business Growth Consulting',
    description: 'Helping organizations identify opportunities, optimize marketing processes, and scale effectively.',
    tags: ['SUSTAINABLE SCALE', 'FUNNEL DIAGNOSTICS']
  }
];

const skills = [
  'Digital Marketing Leadership',
  'Growth Strategy',
  'SEO & Website Optimization',
  'Social Media Marketing',
  'Performance Advertising',
  'Marketing Automation',
  'Content Strategy',
  'Brand Development',
  'Campaign Planning',
  'Analytics & Reporting'
];
---

<Layout
  title="Shishir Khanal | Digital Marketing Strategist & Growth Consultant in Nepal"
  description="I help brands, businesses, and entrepreneurs transform ideas into measurable growth through strategy, creativity, and digital innovation."
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan/10 border border-cyan/30 text-cyan font-mono text-xs font-semibold tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-cyan animate-pulse"></span>
            <span>DIGITAL MARKETING STRATEGIST // KATHMANDU, NEPAL</span>
          </div>

          <div class="space-y-2">
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-extrabold tracking-tight text-white leading-[1.05]">
              Shishir <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan via-teal-300 to-emerald-400">Khanal</span>
            </h1>
            <p class="font-display font-bold text-xl sm:text-2xl text-slate-300 tracking-wide">
              Growth Consultant & Marketer
            </p>
          </div>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
            I help brands, businesses, and entrepreneurs transform ideas into measurable growth through strategy, creativity, and digital innovation. Defying gravitational friction across every campaign.
          </p>

          <!-- CTAs -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/services"
              class="px-7 py-3.5 rounded-xl bg-cyan text-black font-mono font-bold text-sm tracking-wider uppercase transition-all duration-300 hover:shadow-glow-cyan hover:scale-[1.02] active:scale-[0.98] inline-flex items-center gap-2"
            >
              <span>View Services</span>
              <span>⚡</span>
            </a>

            <a
              href="/contact"
              class="px-7 py-3.5 rounded-xl bg-dark-900 border border-white/20 text-white font-mono font-bold text-sm tracking-wider uppercase transition-all duration-300 hover:border-cyan hover:text-cyan hover:bg-dark-850 inline-flex items-center gap-2 group"
            >
              <span>Let's Connect</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>

          <!-- Live Telemetry Pill Bar -->
          <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-white/10 font-mono text-xs text-slate-400">
            <div class="p-2.5 rounded-xl bg-dark-900/60 border border-white/5">
              <span class="text-slate-400 block text-[10px] uppercase">Approach</span>
              <span class="text-slate-200 font-bold">360° OMNICHANNEL</span>
            </div>
            <div class="p-2.5 rounded-xl bg-dark-900/60 border border-white/5">
              <span class="text-slate-400 block text-[10px] uppercase">Location</span>
              <span class="text-slate-200 font-bold">KATHMANDU, NEPAL</span>
            </div>
            <div class="p-2.5 rounded-xl bg-dark-900/60 border border-white/5">
              <span class="text-slate-400 block text-[10px] uppercase">Portal</span>
              <span class="text-cyan font-bold">khanalshishir.com.np</span>
            </div>
          </div>

        </div>

        <!-- Right Hero Visual / Hologram Card -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-sm">
            <!-- Glow background -->
            <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan to-accent-indigo rounded-3xl blur-xl opacity-40 group-hover:opacity-70 transition duration-1000 animate-pulse-subtle"></div>
            
            <div class="relative rounded-3xl bg-dark-900 border border-white/15 p-4 sm:p-5 shadow-2xl backdrop-blur-xl">
              <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-dark-950 border border-white/10">
                <img
                  src="/images/shishir-profile.jpg"
                  alt="Shishir Khanal - Growth Consultant and Digital Marketing Strategist in Nepal"
                  width="400"
                  height="500"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="w-full h-full object-cover object-center"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/20 to-transparent"></div>
                
                <!-- Overlay Badges -->
                <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-dark-950/80 backdrop-blur-md border border-cyan/40 text-cyan font-mono text-[11px] font-bold">
                  🛸 ZERO-G STRATEGY
                </div>

                <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-dark-950/90 backdrop-blur-md border border-white/15">
                  <div class="text-xs font-mono text-cyan uppercase tracking-wider">Status</div>
                  <div class="text-sm font-display font-bold text-white mt-0.5">Scaling High-Growth Brands</div>
                  <div class="flex items-center gap-1.5 mt-1 text-[11px] font-mono text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>Active Deployment</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Metric Counters Strip -->
  <section class="py-12 border-y border-white/10 bg-dark-950/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <StatCounter />
    </div>
  </section>

  <!-- Philosophy Spotlight -->
  <section class="py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="badge-cyan mb-4">
        <span>THE ANTIGRAVITY THEORY</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-display font-extrabold text-white tracking-tight">
        Marketing is about people, not platforms.
      </h2>
      <div class="mt-8 p-8 sm:p-10 rounded-3xl bg-dark-900/80 border border-white/10 relative shadow-card">
        <blockquote class="text-xl sm:text-2xl font-display italic text-slate-200 leading-relaxed">
          “Great marketing isn't about selling more — it's about creating meaningful connections.”
        </blockquote>
        <div class="mt-4 font-mono text-sm uppercase tracking-widest text-cyan font-bold">
          — SHISHIR KHANAL
        </div>
        <p class="mt-6 text-base text-slate-300 max-w-3xl mx-auto leading-relaxed">
          I believe that the best marketing systems combine <strong class="text-white">data-driven insight</strong> with <strong class="text-white">genuine creative thinking</strong>. Not campaigns that simply look good, but campaigns that build trust, create lasting brand equity, and deliver measurable outcomes.
        </p>
        <div class="mt-6">
          <a
            href="/about"
            class="inline-flex items-center gap-2 text-sm font-mono text-cyan hover:underline font-bold"
          >
            <span>Read full story & background</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Core Propulsion Engines -->
  <section class="py-20 border-t border-white/10 bg-dark-950/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
        <div>
          <div class="badge-cyan mb-3">
            <span>WHAT I DO // 6 CORE PROPULSION ENGINES</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white tracking-tight">
            End-to-end marketing, from strategy to execution.
          </h2>
        </div>
        <a
          href="/services"
          class="inline-flex items-center gap-2 text-sm font-mono font-bold text-cyan hover:underline self-start md:self-auto"
        >
          <span>Explore all service architectures</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {engines.map((eng) => (
          <div class="glass-card-hover p-7 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-4">
                <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-cyan transition-colors">
                  {eng.num}
                </span>
                <span class="text-2xl">{eng.icon}</span>
              </div>
              <h3 class="font-display font-bold text-xl text-white group-hover:text-cyan transition-colors">
                {eng.title}
              </h3>
              <p class="mt-3 text-sm text-slate-300 leading-relaxed">
                {eng.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-white/10 flex flex-wrap gap-2">
              {eng.tags.map((t) => (
                <span class="px-2.5 py-1 rounded bg-dark-800 text-[10px] font-mono text-cyan/90 border border-cyan/20">
                  {t}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Asteroid Belt / Industries Served -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <IndustryExplorer />
    </div>
  </section>

  <!-- Selected Missions / Case Studies -->
  <section class="py-20 border-t border-white/10 bg-dark-950/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14">
        <div class="badge-emerald mb-3">
          <span>SELECTED MISSIONS // PROVEN OUTCOMES</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white tracking-tight">
          Case Studies in Defying Gravitational Pull.
        </h2>
        <p class="mt-3 text-base text-slate-300">
          Real results for organizations facing intense competitive resistance and complex audience funnels.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {caseStudies.map((cs) => (
          <CaseStudyCard {...cs} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3-Stage Flight Sequence / Approach -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="badge-cyan mb-3">
          <span>MY APPROACH // FLIGHT SEQUENCE</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white tracking-tight">
          Research First. Strategy Next. Execution Always.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="glass-card-hover p-8 relative">
          <div class="font-mono text-4xl font-extrabold text-cyan/40 mb-4">01</div>
          <div class="text-xs font-mono uppercase text-cyan tracking-wider mb-1">Stage 01</div>
          <h3 class="font-display font-bold text-2xl text-white">Research</h3>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">
            Every successful campaign starts with understanding people, markets, and opportunities. Data before assumptions.
          </p>
        </div>

        <div class="glass-card-hover p-8 relative">
          <div class="font-mono text-4xl font-extrabold text-cyan/40 mb-4">02</div>
          <div class="text-xs font-mono uppercase text-cyan tracking-wider mb-1">Stage 02</div>
          <h3 class="font-display font-bold text-2xl text-white">Strategy</h3>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">
            I combine data-driven insights with creative thinking to develop marketing solutions built for the real world.
          </p>
        </div>

        <div class="glass-card-hover p-8 relative">
          <div class="font-mono text-4xl font-extrabold text-cyan/40 mb-4">03</div>
          <div class="text-xs font-mono uppercase text-cyan tracking-wider mb-1">Stage 03</div>
          <h3 class="font-display font-bold text-2xl text-white">Execution</h3>
          <p class="mt-3 text-sm text-slate-300 leading-relaxed">
            Ideas are only as good as their execution. I work closely with teams to ensure strategy translates into results.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Skills Deck -->
  <section class="py-16 border-y border-white/10 bg-dark-950/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="badge-cyan mb-3">
        <span>FEATURED EXPERTISE // SKILLS DECK</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-white mb-8">
        Skills that move the needle.
      </h2>
      <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
        {skills.map((skill) => (
          <span class="px-4 py-2 rounded-xl bg-dark-900 border border-white/10 text-xs sm:text-sm font-mono text-slate-200 hover:border-cyan hover:text-cyan transition-colors">
            {skill}
          </span>
        ))}
      </div>
      <div class="mt-6 text-xs font-mono uppercase tracking-widest text-slate-400">
        FULL STACK MARKETING // STRATEGY • CREATIVE • PERFORMANCE
      </div>
    </div>
  </section>

  <!-- Contact / Transmission Form Section -->
  <section class="py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 space-y-6">
          <div class="badge-cyan">
            <span>LET'S CONNECT // DIRECT LINE</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-white tracking-tight">
            Ready to create something meaningful?
          </h2>
          <p class="text-base text-slate-300 leading-relaxed">
            Whether you're building a new brand, scaling an existing business, or looking for fresh marketing perspectives — I'd love to connect.
          </p>
          <p class="text-sm text-slate-400 font-mono">
            Communications line is monitored daily. Reach out directly via email, WhatsApp, or through the transmission deck.
          </p>

          <div class="pt-4 space-y-3 font-mono text-sm">
            <div class="flex items-center gap-3 p-3 rounded-xl bg-dark-900/60 border border-white/10">
              <span class="text-cyan text-lg">✉️</span>
              <a href="mailto:shishirkhanal1@gmail.com" class="text-white hover:text-cyan transition-colors">
                shishirkhanal1@gmail.com
              </a>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-dark-900/60 border border-white/10">
              <span class="text-emerald-400 text-lg">💬</span>
              <a href="https://wa.me/9779813978652" target="_blank" rel="noopener noreferrer" class="text-white hover:text-emerald-400 transition-colors">
                +977 9813978652 (WhatsApp)
              </a>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-dark-900/60 border border-white/10">
              <span class="text-cyan text-lg">📍</span>
              <span class="text-slate-300">Kathmandu, Nepal</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
